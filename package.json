	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dist": "bun dist:types && bun build --minify --outdir ./dist --target browser ./src/index.ts",
		"dist:types": "bunx tsc --emitDeclarationOnly --declaration --outDir ./dist",
		"prepublishOnly": "bun dist"
	},
	"devDependencies": {
		"typescript": "^7.0.2"
	}
}
